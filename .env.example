# Copia este archivo como .env y rellena tus valores. El archivo .env nunca se sube a git.

# Clave de la API de Anthropic (se crea en https://platform.claude.com, se factura aparte de Claude Pro/Max).
# Si la dejas vacía, la app funciona en "modo sin IA" (borrador extractivo).
ESTUDIO_ANTHROPIC_API_KEY=

# Opcional
# ESTUDIO_DATA_DIR=/Users/tu-usuario/Sistema-de-Estudio
# ESTUDIO_HOST=127.0.0.1     # pon 0.0.0.0 solo si quieres abrir la app desde el iPad en tu red local
# ESTUDIO_PORT=8765
